# Copie este arquivo para .env. O .env NUNCA vai para o git.

# --- Banco de dados ---
# Escolha UM caminho: deixe uma linha DATABASE_URL ativa e a outra comentada (com #).

# Caminho 1 - SQLite: um arquivo local (todo_list.db), criado sozinho na primeira
# execução. Não precisa instalar nem configurar nada. Bom para começar.
DATABASE_URL=sqlite:///./todo_list.db

# Caminho 2 - PostgreSQL no Render: cole a "External Database URL"
# (Render > seu banco > Connections) com DUAS mudanças:
#  1. troque o inicio "postgresql://" por "postgresql+psycopg://"
#  2. acrescente "?sslmode=require" no fim
# DATABSE_URL=postgresql+psycopg://USUARIO:SENHA@HOST.oregon-postgres.render.com/BANCO?sslmode-require

# ---Autenticação (JWT) ---
# Segredo que assina os tokens: mínimo 32 caracteres, diferente em cada instalação.
# Gere um com: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=troque_por_um_segredo_gerado
# Por quantos minutos um login continua valendo.
JWT_EXPIRA_MINUTOS=123